# Rust build output. Cargo.lock is committed on purpose (estrogen ships binaries),
# so it is not ignored here.
/target
**/*.rs.bk

# npm launcher and per-target packages (npm/ is another agent's area; these
# patterns keep its build and install output out of git).
node_modules/
*.node
*.tgz
/npm/*/estrogen
/npm/*/estrogen.exe

# OS cruft
.DS_Store

# Astro generated cache
.astro/

# Agent worktrees
.claude/worktrees/

# Generated demo wasm. web/scripts/build-wasm.sh regenerates these from
# crates/estrogen-wasm at build time (npm prebuild), so they are not committed.
web/src/wasm/
