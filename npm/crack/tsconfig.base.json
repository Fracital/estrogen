{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"moduleResolution": "node",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": false,
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"types": ["node"],
		"rootDir": "src"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
