---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import logo from '../assets/estrogen.png';

const NPM = 'https://www.npmjs.com/package/@sysce/estrogen';
const REPO = 'https://github.com/Fracital/estrogen';
---

<Base>
	<header class="holo-actionBar">
		<span class="holo-title">
			<Image src={logo} alt="" width={36} height={36} />
			estrogen
		</span>
		<div class="brand-actions">
			<a
				class="npm-pill"
				href={NPM}
				target="_blank"
				rel="noopener"
				aria-label="estrogen on npm"
			>
				<svg
					class="brand-mark"
					width="34"
					height="13"
					viewBox="0 0 780 250"
					aria-hidden="true"
				>
					<path
						fill="currentColor"
						d="M240,250h100v-50h100V0H240V250z M340,50h50v100h-50V50z M480,0v200h100V50h50v150h50V50h50v150h50V0H480z M0,200h100V50h50v150h50V0H0V200z"
					></path>
				</svg>
				<span class="pkg">@sysce/estrogen</span>
			</a>
			<a
				class="gh-btn"
				href={REPO}
				target="_blank"
				rel="noopener"
				aria-label="estrogen on GitHub"
			>
				<svg
					class="brand-mark"
					width="18"
					height="18"
					viewBox="0 0 16 16"
					aria-hidden="true"
				>
					<path
						fill="currentColor"
						fill-rule="evenodd"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
				<span>GitHub</span>
			</a>
		</div>
	</header>

	<main class="wrap">
		<p class="lede">
			Estrogen transforms your JavaScript to be more fun for internet
			crawlers. Running <code>@sysce/estrogen</code> in WASM.
		</p>

		<section class="panel" id="app">
			<div class="tabs" role="tablist">
				<button class="tab active" type="button" data-tab="code" role="tab"
					>Copy &amp; paste JavaScript</button
				>
				<button class="tab" type="button" data-tab="upload" role="tab"
					>Upload a folder</button
				>
				<button class="tab" type="button" data-tab="output" role="tab"
					>Output</button
				>
			</div>

			<div class="pane active" data-pane="code">
				<div class="editor-wrap">
					<textarea id="editor"></textarea>
				</div>
			</div>

			<div class="pane" data-pane="upload">
				<div class="dropzone" id="dropZone">
					<svg
						class="dz-icon"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path
							d="M12 16V4m0 0 4 4m-4-4-4 4M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"
						></path>
					</svg>
					<span class="big">Pick a folder, or drop files here</span>
					<span class="sub"
						>drop in your codebase and we will take care of the rest! (html, js,
						and css supported)</span
					>
				</div>
				<input
					type="file"
					id="folderInput"
					webkitdirectory
					multiple
					hidden
				/>
				<div class="upload-status" id="uploadStatus">
					<progress id="progressBar" value="0" max="100"></progress>
					<div class="progress-text" id="progressText"></div>
					<div class="skips" id="skips"></div>
					<div class="bar">
						<button id="downloadZipBtn" disabled>Download .zip</button>
					</div>
				</div>
			</div>

			<div class="pane" data-pane="output">
				<div class="viewer">
					<nav class="files" id="fileList" aria-label="Output files"></nav>
					<div
						class="files-resize"
						id="filesResize"
						role="separator"
						aria-orientation="vertical"
						aria-label="Resize the file list"
						tabindex="0"
					></div>
					<div class="view">
						<div class="view-head">
							<span class="view-path" id="viewPath"></span>
							<button class="copy-btn" id="copyBtn" type="button">Copy</button>
						</div>
						<textarea id="output" readonly spellcheck="false"></textarea>
						<div class="unsupported" id="unsupported" hidden>
							<span class="big">No preview for this file</span>
							<span class="sub"
								>The viewer shows UTF-8 text and JSON. This file is binary, so
								download it to open it.</span
							>
						</div>
					</div>
				</div>
				<div class="output-meta">
					<span id="editsCount"></span>
					<button id="downloadBtn" disabled type="button">Download .js</button>
					<button id="downloadMapBtn" hidden type="button"
						>Download .js.map</button
					>
					<button id="downloadAllBtn" disabled type="button">Download .zip</button>
				</div>
			</div>

			<ul class="holo-list opts">
				<li class="row">
					<label>
						<span class="grow">
							<span class="title">Wrap lines</span>
							<span class="summary"
								>Soft wrap long lines in the editor and the output instead of
								scrolling sideways</span
							>
						</span>
						<input id="wrapToggle" type="checkbox" />
					</label>
				</li>
				<li class="row">
					<label>
						<span class="grow">
							<span class="title">Virtual Machine</span>
							<span class="summary"
								>makes the JS really nice, minor performance overhead</span
							>
						</span>
						<input id="vmToggle" type="checkbox" checked />
					</label>
				</li>
				<li>
					<label class="title" for="seed">Seed</label>
					<input
						id="seed"
						type="text"
						placeholder="empty = random keys each run"
						spellcheck="false"
						autocomplete="off"
					/>
					<span class="summary"
						>A fixed seed makes the keys, and the output, the same on every run.</span
					>
				</li>
			</ul>

			<div class="bar">
				<button id="resetBtn" type="button">Reset</button>
				<button id="obfuscateBtn" type="button">Obfuscate</button>
			</div>
		</section>

		<h2>FAQ</h2>
		<ul class="holo-list faq">
			<li>
				<span class="title">Why obfuscate your JavaScript?</span>
				<span class="summary"
					>To make a shipped build harder to read for crawlers, scrapers and the
					casual copy and paste. estrogen takes the plain string and template
					literals out of the source and stores them in an encrypted pool, so a
					reader cannot grep for a message, a URL or a key name and land on the
					line that uses it.</span
				>
			</li>
			<li>
				<span class="title">Is this foolproof?</span>
				<span class="summary"
					>No. The browser has to run the code, so a reader with time and
					patience can work it back. estrogen makes that a lot more work, which
					is the point.</span
				>
			</li>
			<li>
				<span class="title">Why is the output larger than the source?</span>
				<span class="summary"
					>The pass prepends a decoder and stores the literals as an encrypted
					base64 pool, which is bigger than the plain text it replaced. The
					decoder repeats a lot, so the output compresses well with gzip or
					brotli, which most servers already send.</span
				>
			</li>
			<li>
				<span class="title">Does it work on any JavaScript?</span>
				<span class="summary"
					>It works on standard JavaScript and Node source that parses, including
					.mjs and .cjs. This page runs one source string at a time, or every
					.js, .mjs and .cjs file when you upload a folder. If the engine finds
					nothing to rewrite, it returns the input unchanged. In a folder, a file
					that fails to parse is copied through and listed as skipped.</span
				>
			</li>
			<li>
				<span class="title">Is my code uploaded anywhere?</span>
				<span class="summary"
					>No. There is no server. The engine is WebAssembly running in this
					page, so your source never leaves your browser. Reload the tab and it
					is gone.</span
				>
			</li>
			<li>
				<span class="title">Can I run it on my own machine?</span>
				<span class="summary"
					>Yes. estrogen is a post-build obfuscator published to npm as
					<code>@sysce/estrogen</code>. It rewrites an already-built output
					directory and has an Astro integration for build-time use. This page is
					the same engine compiled to WebAssembly.</span
				>
			</li>
		</ul>
	</main>

	<script>
		import '../scripts/app.ts';
	</script>
</Base>
